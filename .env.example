# FactorDesk server configuration.
# Copy this file to ".env" (same folder) and paste your key, then restart: node server.js
# The key is read by server.js only — it is never sent to the browser.

# Optional: adds the "Write this in plain English" buttons. Without it every
# number-driven rule read still works. Get a key at console.groq.com.
GROQ_API_KEY=

# Any Groq chat-completions model name; llama-3.3-70b-versatile is the default.
# Some accounts have no Llama access — check GET /v1/models if you see
# "does not exist or you do not have access". openai/gpt-oss-120b works well here.
GROQ_MODEL=llama-3.3-70b-versatile

# Python yfinance datasource address (started automatically by server.js).
YF_BASE=http://127.0.0.1:8765

# Set to 1 to skip spawning the python service (direct Yahoo fallback only).
FD_NO_YF=
